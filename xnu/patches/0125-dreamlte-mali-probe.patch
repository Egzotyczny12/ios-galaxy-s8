diff --git a/bsd/dev/dreamlte_mali_probe.c b/bsd/dev/dreamlte_mali_probe.c
new file mode 100644
index 0000000000000000000000000000000000000000..ab9a773a9de19c18a58f59d5bd064dc54faf519c
--- /dev/null
+++ b/bsd/dev/dreamlte_mali_probe.c
@@ -0,0 +1,83 @@
+/*
+ * Read-only, opt-in Mali-G71 discovery for Samsung Galaxy S8 (dreamlte).
+ * This is a diagnostic checkpoint only: it never powers the GPU, changes
+ * clocks, installs interrupts, or submits work.
+ */
+#if defined(ARM64_BOARD_CONFIG_A5XELTE)
+#include <sys/types.h>
+#include <sys/systm.h>
+#include <machine/machine_routines.h>
+#include <pexpert/pexpert.h>
+
+extern vm_offset_t ml_io_map(vm_offset_t, vm_size_t);
+
+#define S8_G3D_PMU_PA       0x16480000u
+#define S8_G3D_PMU_SIZE     0x5000u
+#define S8_G3D_PD_CONFIG    0x40e0u
+#define S8_G3D_PD_STATUS    0x40e4u
+#define S8_G3D_CMU_PA       0x13800000u
+#define S8_G3D_CMU_SIZE     0x2000u
+#define S8_G3D_SWITCH_USER  0x0100u
+#define S8_G3D_GPU_PA       0x13900000u
+#define S8_G3D_GPU_SIZE     0x5000u
+#define S8_G3D_GPU_ID       0x0000u
+#define S8_G3D_L2_FEATURES  0x0004u
+#define S8_G3D_AS_PRESENT   0x0018u
+#define S8_G3D_SHADER       0x1000u
+
+static uint32_t
+s8g3d_read(vm_offset_t base, uint32_t offset)
+{
+	uint32_t value = *(volatile uint32_t *)(base + offset);
+	__asm__ volatile("dmb oshld" ::: "memory");
+	return value;
+}
+
+void
+dreamlte_mali_probe(void)
+{
+	uint32_t level = 0;
+	vm_offset_t pmu, cmu, gpu;
+
+	(void)PE_parse_boot_argn("mali_probe", &level, sizeof(level));
+	if (level == 0) {
+		return;
+	}
+	if (level > 2) {
+		printf("S8-MALI: mali_probe accepts 1 (power/clock) or 2 (read G71 identity)\n");
+		return;
+	}
+
+	pmu = ml_io_map(S8_G3D_PMU_PA, S8_G3D_PMU_SIZE);
+	cmu = ml_io_map(S8_G3D_CMU_PA, S8_G3D_CMU_SIZE);
+	if (pmu == 0 || cmu == 0) {
+		printf("S8-MALI: MMIO map failed; no GPU access attempted\n");
+		return;
+	}
+
+	uint32_t pd_config = s8g3d_read(pmu, S8_G3D_PD_CONFIG);
+	uint32_t pd_status = s8g3d_read(pmu, S8_G3D_PD_STATUS);
+	uint32_t switch_user = s8g3d_read(cmu, S8_G3D_SWITCH_USER);
+	printf("S8-MALI: read-only probe level=%u pd_cfg=%#x pd_status=%#x switch_user=%#x\n",
+	    level, pd_config, pd_status, switch_user);
+	if (level < 2) {
+		return;
+	}
+	if ((pd_status & 0xfu) != 0xfu) {
+		printf("S8-MALI: G3D power domain is not fully on; GPU registers skipped\n");
+		return;
+	}
+
+	/* The power-domain status is the required guard before touching Mali MMIO. */
+	gpu = ml_io_map(S8_G3D_GPU_PA, S8_G3D_GPU_SIZE);
+	if (gpu == 0) {
+		printf("S8-MALI: GPU MMIO map failed\n");
+		return;
+	}
+	printf("S8-MALI: id=%#x l2=%#x as=%#x shader_present=%#x\n",
+	    s8g3d_read(gpu, S8_G3D_GPU_ID),
+	    s8g3d_read(gpu, S8_G3D_L2_FEATURES),
+	    s8g3d_read(gpu, S8_G3D_AS_PRESENT),
+	    s8g3d_read(gpu, S8_G3D_SHADER));
+}
+#endif /* ARM64_BOARD_CONFIG_A5XELTE */

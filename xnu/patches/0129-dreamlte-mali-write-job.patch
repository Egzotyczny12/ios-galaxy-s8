+	uint32_t level = 0, clock_200 = 0, job_test = 0;
 	vm_offset_t pmu, cmu, top, gpu;
 
 	(void)PE_parse_boot_argn("mali_probe", &level, sizeof(level));
 	(void)PE_parse_boot_argn("mali_clock", &clock_200, sizeof(clock_200));
+	(void)PE_parse_boot_argn("mali_job", &job_test, sizeof(job_test));
 	if (level == 0) {
 		return;
 	}
@@ -156,8 +301,9 @@ dreamlte_mali_probe(void)
 	    s8g3d_read(gpu, S8_G3D_L2_FEATURES),
 	    s8g3d_read(gpu, S8_G3D_AS_PRESENT),
 	    s8g3d_read(gpu, S8_G3D_SHADER));
+	bool clock_ok = false;
 	if (clock_200 == 200) {
-		(void)s8g3d_clock_200(cmu, top, pd_status, gpu_id);
+		clock_ok = s8g3d_clock_200(cmu, top, pd_status, gpu_id);
 	}
 	if (level < 3) {
 		return;
@@ -174,5 +320,12 @@ dreamlte_mali_probe(void)
 	    s8g3d_read(gpu, S8_G3D_MMU_FEATURES),
 	    s8g3d_read(gpu, S8_G3D_JS_PRESENT),
 	    s8g3d_read(gpu, S8_G3D_INT_RAWSTAT));
+	if (job_test == 1) {
+		if (!clock_ok) {
+			printf("S8-MALI: GPU job not attempted; mali_clock=200 readback guard did not pass\n");
+			return;
+		}
+		(void)s8g3d_job_test(gpu);
+	}
 }
